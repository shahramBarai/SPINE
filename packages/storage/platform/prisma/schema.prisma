generator client {
    provider      = "prisma-client"
    output        = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// User model
model User {
    id       String   @id @default(cuid())
    email    String   @unique
    name     String?
    password String
    role     UserRole @default(USER)

    entityMemberships EntityMember[]
    jobExecutions     JobExecution[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// User roles
enum UserRole {
    ADMIN
    USER
}

// Entity model
model Entity {
    id       String   @id @default(cuid())
    // guid     String   @unique

    name     String
    description String?
    type     EntityType
    isTwinEnabled Boolean @default(false)
    coverImageKey String?

    members  EntityMember[]
    sensors  SensorData[]

    kafkaTopics KafkaTopic[]
    flinkTasks  Pipeline[]
    jobExecutions JobExecution[]
    apiKeys ApiKey[]
    files File[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// Entity types
enum EntityType {
    DISTRICT
    CAMPUS
    BUILDING
    LAB
    PROJECT
}

model EntityMember {
    entityId String
    userId   String
    role     MemberRole
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([entityId, userId])
}

// Member roles
enum MemberRole {
    OWNER
    VIEWER
    EDITOR
}

// Pipeline model for Flink jobs
model Pipeline {
    id          String  @id @default(cuid())
    name        String
    description String?
    config      Json // Stores pipeline configuration
    version     Int     @default(1)
    isActive    Boolean @default(false)

    entityId String
    createdBy String
    editedBy  String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
}

// Log of executed async jobs - tool runs today (e.g. building-service's
// IFC->TTL conversion), Flink pipeline runs later via source. This is the
// run *instance* (this input, by this user, at this time, with this
// status); Pipeline above is the saved job *definition*. externalJobId is
// whatever id the actual executing service hands back - this row tracks
// it, it doesn't replace it.
model JobExecution {
    id            String             @id @default(cuid())
    source        JobSource
    jobKey        String // e.g. a tools.ts tool id, or a Pipeline id
    externalJobId String?
    status        JobExecutionStatus @default(QUEUED)
    input         Json?
    result        Json?
    error         String?

    entityId   String
    executedBy String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
    user   User   @relation(fields: [executedBy], references: [id], onDelete: Cascade)

    @@index([entityId])
    @@index([executedBy])
}

enum JobSource {
    TOOL
    FLINK
}

enum JobExecutionStatus {
    QUEUED
    RUNNING
    COMPLETED
    FAILED
}

// Lets external systems authenticate against a single project (e.g. to run
// read-only SPARQL queries against its dataset) without a full user
// session. Only keyHash (a fast SHA-256 digest, not a slow password hash -
// a random high-entropy key doesn't need one) is ever stored; the raw key
// is shown to the owner once, at creation, and is unrecoverable after that.
// keyPrefix is a non-secret slice of the raw key kept only so the owner can
// tell keys apart in the UI without re-hashing every guess.
model ApiKey {
    id         String    @id @default(cuid())
    name       String
    keyHash    String    @unique
    keyPrefix  String

    entityId   String

    canReadGraph Boolean   @default(false)
    fileGrants ApiKeyFile[]
    expiresAt    DateTime?

    lastUsedAt DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    entity     Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)

    @@index([entityId])
}

model ApiKeyFile {
    apiKeyId  String
    fileId    String
    createdAt DateTime @default(now())

    apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
    file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

    @@id([apiKeyId, fileId])
    @@index([fileId])
}

// Kafka topic model for Kafka topics
model KafkaTopic {
    topicName   String     @id
    description String?
    stage       TopicStage
    dataFormat  DataFormat @default(STRING)
    schemaId    String?    @db.Uuid
    entityId    String

    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
}

enum TopicStage {
    RAW
    VALIDATED
    ANALYTICS
    SYSTEM
}

enum DataFormat {
    STRING
    JSON
    BYTES
    AVRO
    PROTOBUF
}


// ------SENSOR DATA TABLES------
enum SensorType {
    UNKNOWN
    TEMPERATURE
    HUMIDITY
}

model SensorData {
    id          String  @id @default(cuid())
    guid        String?

    type        SensorType @default(UNKNOWN)
    name        String?
    description String?

    tags        SensorTag[]

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    entityId    String
    entity      Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

    @@index([entityId])
    @@index([type])
}

model SensorTag {
    name        String @id

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    sensorData SensorData[]
}

// ------PROJECT FILES------

// id is not auto-generated - it's the same fileId minted by
// ProjectFileService.getProjectFileUploadUrl.
model File {
    id        String  @id
    fileName  String
    size      Int
    mimeType  String
    objectKey String  @unique

    entityId    String
    createdBy   String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    entity       Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
    apiKeyGrants ApiKeyFile[]

    @@index([entityId])
}

