# Build context must be the repository root so workspace packages are
# available - see modules/app/docker-compose.dev.yml, or build by hand with:
#   docker build -f modules/app/frontend/Dockerfile.dev .
#
# Node 22 because Vite 8 requires ^20.19.0 || >=22.12.0, which the
# node:20-alpine3.17 tag used by the older module images does not satisfy.
FROM node:22-alpine

RUN apk add --no-cache libc6-compat

WORKDIR /workspace

# Manifests first so the install layer caches independently of source edits.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./

# The only workspace package the frontend imports at runtime (vite.config.ts
# reads BACKEND_URL through it).
COPY packages/shared ./packages/shared

COPY modules/app/frontend ./modules/app/frontend

# corepack takes the pnpm version from the root package.json's
# "packageManager" field - don't pin a different one here.
RUN corepack enable
RUN pnpm install --frozen-lockfile

WORKDIR /workspace/modules/app/frontend

# vite.config.ts already binds 0.0.0.0:3000, so the dev server is reachable
# from the host without extra flags.
EXPOSE 3000

# Note: `pnpm build` (tsc && vite build) additionally needs ../backend/src,
# which the tsconfig maps to `@server/*` for type-only imports. It is not
# copied here because this image only runs the dev server; the compose
# service bind-mounts the repo, which covers it.
CMD ["pnpm", "run", "dev"]
